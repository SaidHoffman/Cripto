<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    
    <!-- Configuración del handler para Python/Django -->
    <handlers>
      <add name="PythonHandler" 
           path="*" 
           verb="*" 
           modules="httpPlatformHandler" 
           resourceType="Unspecified"/>
    </handlers>
    
    <!-- Configuración de la plataforma HTTP -->
    <httpPlatform processPath="D:\home\Python312\python.exe"
                  arguments="D:\home\site\wwwroot\manage.py runserver --noreload 0.0.0.0:%HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\home\LogFiles\python.log"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      
      <!-- Variables de entorno -->
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="D:\home\site\wwwroot" />
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="dental_project.settings" />
        <environmentVariable name="WEBSITE_HOSTNAME" value="%WEBSITE_HOSTNAME%" />
      </environmentVariables>
    </httpPlatform>
    
    <!-- Reglas de reescritura para manejar archivos estáticos -->
    <rewrite>
      <rules>
        <!-- Servir archivos estáticos directamente -->
        <rule name="Static Files" stopProcessing="true">
          <match url="^(static|media)/.*" />
          <action type="Rewrite" url="{R:0}" />
        </rule>
        
        <!-- NO forzar redirección HTTPS para evitar bucles -->
        <!-- Azure maneja HTTPS automáticamente -->
      </rules>
    </rewrite>
    
    <!-- Configuración de seguridad -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Configuración de archivos estáticos -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
    
    <!-- Configuración de errores personalizados -->
    <httpErrors errorMode="Detailed" />
    
  </system.webServer>
</configuration>
